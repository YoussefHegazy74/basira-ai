# Copy this file to .env and replace every placeholder.
# Use "production" when serving over HTTPS (enables Secure auth cookies).
NODE_ENV=development
# .env is intentionally ignored by Git; never commit real credentials.
OPENAI_API_KEY=replace-with-openai-api-key

DB_URI=mongodb://127.0.0.1:27017
DB_NAME=basira
PORT=3000

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
# Optional comma-separated additional browser origins allowed by CORS.
CORS_ORIGINS=

AI_URL=http://127.0.0.1:8000

# Optional for guest chat; required for registration/password reset.
# For Gmail, SMTP_SERVICE=gmail and SMTP_PASSWORD is an app password,
# not the account password.
SMTP_SERVICE=replace-with-smtp-service
SMTP_USER=replace-with-smtp-login
SMTP_PASSWORD=replace-with-smtp-password
